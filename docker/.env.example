# Copie para docker/.env e ajuste.

# Pasta dos assets do Tibia (proprietários da Cipsoft — não vão na imagem).
# Precisa conter: assets/catalog-content.json + package.json + appearances*.dat
# Ex.: um release do dudantas/tibia-client, ou os dados do seu servidor Canary.
TIBIA_ASSETS=/caminho/para/tibia-client

# Opcional: resolução do xvfb do editor
# SCREEN=1600x1000x24
