# Remere's Map Editor (canary-map-editor v4.0) headless + noVNC.
# O binário é baixado do release fixado do opentibiabr (o build v4.0 exige
# glibc 2.38 -> base 24.04). Os assets do Tibia NÃO vão aqui (proprietários da
# Cipsoft) — são montados em /rme-client pelo docker-compose.
FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive
ARG RME_RELEASE=v4.0
ARG RME_ZIP=canary-map-editor-v4.0-ubuntu-24.04.zip

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl unzip jq \
      xvfb x11vnc websockify novnc matchbox-window-manager x11-utils \
      mesa-utils libgl1 libglu1-mesa libglx-mesa0 libgl1-mesa-dri libegl1 \
      libgtk-3-0 libnotify4 libsecret-1-0 libasound2t64 \
      libx11-6 libxext6 libxft2 libxi6 libxrandr2 libxtst6 libxkbcommon0 \
      libxmu6 libxrender1 libxxf86vm1 libdbus-1-3 libwayland-client0 \
    && rm -rf /var/lib/apt/lists/*

# o zip traz uma pasta de topo (canary-map-editor-v4.0-ubuntu-24.04/) — achata pra /rme
RUN cd /tmp \
    && curl -fsSL -o rme.zip \
       "https://github.com/opentibiabr/remeres-map-editor/releases/download/${RME_RELEASE}/${RME_ZIP}" \
    && unzip -q rme.zip && rm rme.zip \
    && mv "$(find /tmp -maxdepth 1 -type d -name 'canary-map-editor-*')" /rme \
    && chmod +x /rme/canary-map-editor \
    && chmod -R a+rwX /rme   # editor-on-host-display.sh roda como o UID do host

COPY docker/entrypoint-editor.sh /entrypoint-editor.sh
RUN chmod +x /entrypoint-editor.sh

EXPOSE 8080
ENTRYPOINT ["/entrypoint-editor.sh"]
