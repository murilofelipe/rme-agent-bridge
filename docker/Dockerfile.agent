# Ambiente isolado do agente (Fase 3 de docs/planejamento/arquitetura.md).
# Python para o cérebro do agente + Node para rodar a SDK internamente.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    NODE_VERSION=20.x \
    RME_API_URL=http://host.docker.internal:8080

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates gnupg \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && apt-get purge -y gnupg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# SDK Node
COPY sdk-node/package.json sdk-node/package-lock.json* ./sdk-node/
RUN cd sdk-node && npm install --omit=dev || npm install

# Agente Python
COPY agent-python/pyproject.toml ./agent-python/
COPY agent-python/app ./agent-python/app
RUN pip install --no-cache-dir ./agent-python

COPY sdk-node ./sdk-node
COPY agent-python ./agent-python

# TODO(fase-3): entrypoint real do agente.
CMD ["python", "-m", "app.main"]
